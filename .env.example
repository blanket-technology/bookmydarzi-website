# Copy this file to .env.local and fill in real values. .env.local is
# gitignored - never commit real secrets/IDs, this file only documents
# which variables exist and where to get them.

# Canonical production domain - every sitemap entry, canonical URL, and
# absolute OpenGraph/Twitter image URL is derived from this (see lib/seo.ts).
# Falls back to https://bookmydarzi.com if unset.
NEXT_PUBLIC_SITE_URL=https://bookmydarzi.com

# GA4 Measurement ID for traffic/conversion tracking. Get it from:
# analytics.google.com -> Admin -> Data Streams -> your web stream -> "G-XXXXXXXXXX"
# Analytics is silently skipped (no script loaded) when this is unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Search Console ownership verification (HTML tag method). Get it from:
# search.google.com/search-console -> Settings -> Ownership verification
# -> HTML tag -> copy ONLY the content="..." value, not the whole <meta> tag.
# Required to submit the sitemap and see indexing/search-query data in
# Search Console. No verification meta tag is rendered when this is unset.
GOOGLE_SITE_VERIFICATION=
